<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>İzEvent | Organizasyon & Etkinlik</title>
  <meta name="description" content="İzEvent Organizasyon - Düğün, nişan, özel davet, kurumsal etkinlik ve dekorasyon hizmetleri.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: "Montserrat", sans-serif;
      background: #f8f5ee;
      color: #34372f;
      line-height: 1.6;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(250, 248, 242, 0.97);
      border-bottom: 1px solid rgba(70, 80, 65, 0.08);
      backdrop-filter: blur(10px);
    }

    .nav {
      max-width: 1250px;
      margin: auto;
      padding: 16px 28px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 30px;
    }

    .brand {
      min-width: 190px;
    }

    .brand-main {
      display: flex;
      align-items: flex-end;
      line-height: 0.85;
      color: #4e5547;
    }

    .brand-iz {
      font-family: "Cormorant Garamond", serif;
      font-size: 54px;
      font-weight: 600;
      letter-spacing: -7px;
      position: relative;
      padding-right: 7px;
    }

    .brand-iz::before {
      content: "❧";
      position: absolute;
      left: -23px;
      top: 18px;
      font-size: 22px;
      transform: rotate(-25deg);
      opacity: .8;
    }

    .brand-event {
      font-family: "Cormorant Garamond", serif;
      font-size: 38px;
      font-weight: 400;
    }

    .brand-sub {
      margin-top: 8px;
      padding-left: 6px;
      font-size: 8px;
      letter-spacing: 6px;
      color: #6f7368;
    }

    nav ul {
      list-style: none;
      display: flex;
      align-items: center;
      gap: 30px;
      font-size: 13px;
      color: #55594f;
    }

    nav a:hover {
      color: #7d8873;
    }

    .offer-btn {
      background: #687261;
      color: white;
      border-radius: 28px;
      padding: 12px 24px;
      font-size: 12px;
      letter-spacing: .8px;
      white-space: nowrap;
    }

    .hero {
      min-height: 650px;
      display: flex;
      align-items: center;
      background:
        linear-gradient(
          90deg,
          rgba(249,246,239,.99) 0%,
          rgba(249,246,239,.94) 38%,
          rgba(249,246,239,.45) 57%,
          rgba(249,246,239,.08) 80%
        ),
        url("https://images.unsplash.com/photo-1519167758481-83f550bb49b3?auto=format&fit=crop&w=1800&q=90");
      background-size: cover;
      background-position: center;
    }

    .hero-inner {
      width: 100%;
      max-width: 1250px;
      margin: auto;
      padding: 80px 55px;
    }

    .line {
      width: 42px;
      height: 1px;
      background: #858978;
      margin-bottom: 22px;
    }

    .eyebrow {
      font-size: 10px;
      letter-spacing: 5px;
      color: #74796c;
      text-transform: uppercase;
      margin-bottom: 20px;
    }

    h1 {
      font-family: "Cormorant Garamond", serif;
      font-size: clamp(64px, 7vw, 98px);
      line-height: .9;
      font-weight: 500;
      color: #465044;
      max-width: 590px;
      margin-bottom: 28px;
    }

    .hero-copy {
      max-width: 540px;
      font-size: 15px;
      line-height: 1.9;
      color: #4f534c;
      margin-bottom: 34px;
    }

    .main-btn {
      display: inline-block;
      background: #687362;
      color: white;
      padding: 16px 30px;
      font-size: 11px;
      letter-spacing: 4px;
      transition: .3s;
    }

    .main-btn:hover {
      background: #535d4f;
    }

    section {
      padding: 90px 30px;
    }

    .section-title {
      text-align: center;
      margin-bottom: 60px;
    }

    .section-title::before {
      content: "";
      display: block;
      width: 40px;
      height: 1px;
      background: #8d927d;
      margin: 0 auto 17px;
    }

    .section-title h2 {
      font-family: "Cormorant Garamond", serif;
      font-size: 54px;
      font-weight: 500;
      color: #465044;
    }

    .section-title p {
      font-size: 10px;
      letter-spacing: 5px;
      text-transform: uppercase;
      color: #8a8d80;
      margin-top: 8px;
    }

    .services {
      background: #fbf9f4;
    }

    .services-grid {
      max-width: 1100px;
      margin: auto;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 45px;
    }

    .service {
      text-align: center;
    }

    .service-icon {
      width: 84px;
      height: 84px;
      margin: 0 auto 20px;
      border-radius: 50%;
      background: #efebe2;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 31px;
      color: #5d6657;
    }

    .service h3 {
      font-family: "Cormorant Garamond", serif;
      font-size: 25px;
      font-weight: 500;
      margin-bottom: 8px;
      color: #40463d;
    }

    .service p {
      font-size: 13px;
      color: #767970;
      line-height: 1.7;
    }

    .about {
      padding: 0;
      display: grid;
      grid-template-columns: 1fr 1fr;
      min-height: 570px;
      background: #f8f5ee;
    }

    .about-image {
      min-height: 570px;
      background:
        url("https://images.unsplash.com/photo-1507504031003-b417219a0fde?auto=format&fit=crop&w=1400&q=90")
        center/cover no-repeat;
    }

    .about-text {
      padding: 85px 75px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    .about-text::after {
      content: "❧";
      position: absolute;
      right: -35px;
      bottom: -55px;
      font-size: 210px;
      color: rgba(104, 116, 95, 0.11);
      transform: rotate(-18deg);
    }

    .about-text h2 {
      font-family: "Cormorant Garamond", serif;
      font-size: 56px;
      font-weight: 500;
      line-height: 1;
      color: #465044;
      margin-bottom: 23px;
      position: relative;
      z-index: 1;
    }

    .about-text p {
      max-width: 520px;
      font-size: 14px;
      line-height: 1.9;
      color: #5e6259;
      margin-bottom: 28px;
      position: relative;
      z-index: 1;
    }

    .quote {
      background: #dde0d5;
      padding: 52px 25px;
      text-align: center;
    }

    .quote p {
      font-family: "Cormorant Garamond", serif;
      font-size: 42px;
      font-style: italic;
      color: #53594f;
    }

    .contact {
      background: #faf7f0;
      text-align: center;
    }

    .contact h2 {
      font-family: "Cormorant Garamond", serif;
      font-size: 54px;
      font-weight: 500;
      color: #465044;
      margin-bottom: 12px;
    }

    .contact-intro {
      font-size: 14px;
      color: #73776d;
      margin-bottom: 42px;
    }

    .contact-grid {
      max-width: 850px;
      margin: auto;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .contact-item {
      padding: 26px 15px;
      border-top: 1px solid #b5b9aa;
      border-bottom: 1px solid #b5b9aa;
    }

    .contact-icon {
      display: block;
      font-size: 23px;
      margin-bottom: 8px;
    }

    .contact-item a {
      font-size: 12px;
      color: #53584f;
      word-break: break-word;
    }

    footer {
      background: #ece8df;
      padding: 42px 28px 18px;
    }

    .footer-inner {
      max-width: 1150px;
      margin: auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 30px;
    }

    .footer-note {
      font-family: "Cormorant Garamond", serif;
      font-size: 28px;
      font-style: italic;
      color: #62685d;
      text-align: right;
    }

    .copyright {
      margin-top: 30px;
      padding-top: 28px;
      border-top: 1px solid rgba(80,80,70,.12);
      text-align: center;
      font-size: 10px;
      color: #8a8c84;
    }

    @media (max-width: 850px) {

      .nav {
        padding: 14px 22px;
      }

      nav,
      .offer-btn {
        display: none;
      }

      .brand-iz {
        font-size: 45px;
      }

      .brand-event {
        font-size: 31px;
      }

      .brand-sub {
        font-size: 7px;
        letter-spacing: 4px;
      }

      .hero {
        min-height: 650px;
        background:
          linear-gradient(
            90deg,
            rgba(249,246,239,.98) 0%,
            rgba(249,246,239,.90) 52%,
            rgba(249,246,239,.25) 100%
          ),
          url("https://images.unsplash.com/photo-1519167758481-83f550bb49b3?auto=format&fit=crop&w=1000&q=88");
        background-size: cover;
        background-position: 60% center;
      }

      .hero-inner {
        padding: 70px 28px;
      }

      h1 {
        font-size: 62px;
        max-width: 390px;
      }

      .hero-copy {
        max-width: 365px;
        font-size: 14px;
      }

      section {
        padding: 70px 24px;
      }

      .section-title h2 {
        font-size: 45px;
      }

      .section-title p {
        letter-spacing: 3px;
        line-height: 1.8;
      }

      .services-grid {
        grid-template-columns: 1fr 1fr;
        gap: 44px 18px;
      }

      .about {
        grid-template-columns: 1fr;
      }

      .about-image {
        min-height: 430px;
      }

      .about-text {
        padding: 65px 28px;
      }

      .about-text h2 {
        font-size: 48px;
      }

      .quote p {
        font-size: 31px;
      }

      .contact-grid {
        grid-template-columns: 1fr;
      }

      .footer-inner {
        flex-direction: column;
        text-align: center;
      }

      .footer-note {
        text-align: center;
        font-size: 24px;
      }
    }

    @media (max-width: 500px) {

      .hero {
        min-height: 610px;
      }

      h1 {
        font-size: 57px;
      }

      .service-icon {
        width: 72px;
        height: 72px;
        font-size: 27px;
      }

      .service h3 {
        font-size: 22px;
      }

      .service p {
        font-size: 12px;
      }

      .contact h2 {
        font-size: 44px;
      }
    }
  </style>
</head>

<body>

<header>
  <div class="nav">

    <a href="#" class="brand">
      <div class="brand-main">
        <span class="brand-iz">İZ</span>
        <span class="brand-event">Event</span>
      </div>
      <div class="brand-sub">ORGANİZASYON</div>
    </a>

    <nav>
      <ul>
        <li><a href="#">Anasayfa</a></li>
