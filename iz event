      >
        @izeventorganizasyon
      </a>
    </div>

  </div>

</section>

<footer>

  <div class="footer-inner">

    <div class="brand">
      <div class="brand-main">
        <span class="brand-iz">İZ</span>
        <span class="brand-event">Event</span>
      </div>
      <div class="brand-sub">ORGANİZASYON</div>
    </div>

    <div class="footer-note">
      Özel anlara profesyonel dokunuş...
    </div>

  </div>

  <div class="copyright">
    © 2026 İzEvent. Tüm hakları saklıdır.
  </div>

</footer>

</body>
</html>